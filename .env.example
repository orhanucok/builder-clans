# =========================================================================
# Builder Clans — Environment Variables
# Copy to .env.local for development. Never commit secrets.
# =========================================================================

# ---- APP ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Builder Clans"

# ---- SUPABASE -----------------------------------------------------------
# Get these from your Supabase project settings (Project URL + anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- AI PROVIDER --------------------------------------------------------
# Choose: 'openai' | 'anthropic' | 'mock'  (mock = safe offline fallback)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_DEFAULT=gpt-4o-mini

# ---- ANALYTICS ----------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---- ERROR TRACKING -----------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---- FEATURE FLAGS ------------------------------------------------------
# Toggle features per-environment. See lib/features/feature-flags.ts
FEATURE_AI=true
FEATURE_CLANS=false
FEATURE_LEADERBOARD=false
FEATURE_CHALLENGES=false
FEATURE_NATIVE_CHAT=true
FEATURE_GITHUB_INTEGRATION=false

# ---- RATE LIMITING ------------------------------------------------------
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20

# ---- SEED ---------------------------------------------------------------
SEED_USER_PASSWORD=builder-clans-demo-2026
